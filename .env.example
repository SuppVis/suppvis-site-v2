# Existing public content API used by blog/shop/research pages.
NEXT_PUBLIC_API_URL=

# Canonical app URL used later for email unsubscribe links.
APP_BASE_URL=https://www.suppvis.health

# AWS region for server-side DynamoDB writes.
AWS_REGION=us-east-1

# Server-only AWS credentials for a future least-privilege app IAM principal.
# Do not use a personal IAM user's access key in Vercel.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB tables. Use separate table names for production and preview.
DYNAMODB_BETA_APPLICATIONS_TABLE=
DYNAMODB_EMAIL_SUBSCRIBERS_TABLE=
DYNAMODB_EMAIL_CAMPAIGNS_TABLE=suppvis-prod-email-campaigns
DYNAMODB_EMAIL_CAMPAIGN_RECIPIENTS_TABLE=suppvis-prod-email-campaign-recipients
DYNAMODB_SMS_SUBSCRIBERS_TABLE=
DYNAMODB_BROADCAST_AUDIT_LOGS_TABLE=

# SHA-256 hex hash of the bearer token accepted by /api/admin/broadcast-audit.
# Store the raw token only in your password manager, not in this repo.
ADMIN_BROADCAST_TOKEN_HASH=

# Microsoft Entra/Auth.js admin login for /admin.
# Create a single-tenant app registration in Microsoft Entra for suppvis.health.
# Do not commit real IDs or secrets. Add only named admin @suppvis.health users.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ADMIN_ALLOWED_EMAILS=andrew@suppvis.health,connor@suppvis.health,tanner@suppvis.health,hayden@suppvis.health
ADMIN_EMAIL_CAMPAIGNS_ENABLED=false
ADMIN_EMAIL_TEST_SEND_ENABLED=false
ADMIN_EMAIL_BULK_SEND_ENABLED=false
ADMIN_EMAIL_BULK_SEND_INFRA_READY=false
ADMIN_EMAIL_CAMPAIGN_QUEUE_URL=
ADMIN_SMS_ANNOUNCEMENTS_ENABLED=false
ADMIN_SMS_TEST_SEND_ENABLED=false
ADMIN_SMS_TEST_RECIPIENTS=admin1@suppvis.health=+1XXXXXXXXXX,admin2@suppvis.health=+1XXXXXXXXXX
ADMIN_SMS_BULK_SEND_ENABLED=false
ADMIN_SMS_BULK_SEND_INFRA_READY=false
ADMIN_SMS_CAMPAIGN_QUEUE_URL=

# Admin catalog server bridge. The shared secret must be at least 32 bytes and
# must match the platform bridge verifier. These values are server-only.
CATALOG_PLATFORM_BASE_URL=
CATALOG_ADMIN_BRIDGE_SECRET=
ADMIN_SITE_ORIGIN=http://localhost:3000

# Comma-separated exact HTTPS origins used by private presigned image PUT/GET
# URLs. This only extends browser img-src/connect-src CSP; never put credentials,
# paths, wildcards, or bucket secrets here.
CATALOG_IMAGE_BROWSER_ORIGINS=

# Priority beta group cap. Public beta signup remains unlimited.
PRIORITY_BETA_LIMIT=300

# Welcome email/SMS sends are enabled by default when provider configuration is
# present. Set these to false only as an explicit operational shutoff.
WELCOME_EMAIL_ENABLED=true
UNSUBSCRIBE_CONFIRMATION_EMAIL_ENABLED=false
WELCOME_SMS_ENABLED=true

# Future email sending configuration. Do not enable real sends until
# the sender/domain is verified and unsubscribe suppression is wired into sending.
SES_FROM_EMAIL=beta@suppvis.health
SES_FROM_NAME=SuppVis Beta Testers
SES_REGION=us-east-1
SES_CONFIGURATION_SET=suppvis-welcome

# Future Twilio inbound SMS webhook verification.
# Keep false for local-only testing. Production should require signatures
# before a public Twilio webhook is connected.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=+16507025913
TWILIO_WEBHOOK_SIGNATURE_REQUIRED=false
TWILIO_STATUS_CALLBACK_URL=https://www.suppvis.health/api/webhooks/twilio/status

# Recommended before production collection. Not wired yet in this code-only phase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
